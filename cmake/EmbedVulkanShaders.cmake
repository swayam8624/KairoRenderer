# Generate native uint32_t words from the little-endian SPIR-V byte stream.
# No shader compiler or Python is required at game runtime.
cmake_minimum_required(VERSION 3.25)
include("${CMAKE_CURRENT_LIST_DIR}/VulkanShaderManifest.cmake")
if(NOT DEFINED SHADER_DIR OR NOT DEFINED OUTPUT)
    message(FATAL_ERROR "SHADER_DIR and OUTPUT are required")
endif()
set(header "#pragma once\n#include <cstdint>\n#include <span>\n#include <stdexcept>\n#include <string_view>\nnamespace kairo::renderer::detail {\n")
set(lookup "inline std::span<const std::uint32_t> EmbeddedVulkanShader(std::string_view name) {\n")
foreach(name IN LISTS KAIRO_VULKAN_SHADER_NAMES)
    set(path "${SHADER_DIR}/${name}")
    file(SIZE "${path}" size)
    math(EXPR remainder "${size} % 4")
    if(size LESS 20 OR size GREATER 16777216 OR NOT remainder EQUAL 0)
        message(FATAL_ERROR "Invalid SPIR-V size: ${name}")
    endif()
    file(READ "${path}" hex HEX)
    string(SUBSTRING "${hex}" 0 8 magic)
    if(NOT magic STREQUAL "03022307")
        message(FATAL_ERROR "Invalid little-endian SPIR-V magic: ${name}")
    endif()
    string(MAKE_C_IDENTIFIER "${name}" symbol)
    string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u,\n" words "${hex}")
    string(APPEND header "inline constexpr std::uint32_t ${symbol}[] = {\n${words}};\n")
    string(APPEND lookup "    if(name == \"${name}\") return ${symbol};\n")
endforeach()
string(APPEND lookup "    throw std::invalid_argument(\"Unknown embedded Vulkan shader.\");\n}\n}\n")
get_filename_component(output_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${output_dir}")
file(WRITE "${OUTPUT}.tmp" "${header}${lookup}")
file(RENAME "${OUTPUT}.tmp" "${OUTPUT}")
